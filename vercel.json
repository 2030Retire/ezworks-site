{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    {
      "src": "/ko/haru/?",
      "status": 301,
      "headers": { "Location": "https://ezharu.co/ko/products/recorder" }
    },
    {
      "src": "/ko/haru/(.*)",
      "status": 301,
      "headers": { "Location": "https://ezharu.co/ko/products/recorder/$1" }
    },
    {
      "src": "/haru/?",
      "status": 301,
      "headers": { "Location": "https://ezharu.co/products/recorder" }
    },
    {
      "src": "/haru/(.*)",
      "status": 301,
      "headers": { "Location": "https://ezharu.co/products/recorder/$1" }
    },
    {
      "src": "/(ko/)?method/?",
      "status": 301,
      "headers": { "Location": "https://ezharu.co/$1how-we-work" }
    },
    {
      "src": "/(ko/)?services/?",
      "status": 301,
      "headers": { "Location": "https://ezharu.co/$1solutions" }
    },
    {
      "src": "/(ko/)?(about|contact|products)/?",
      "status": 301,
      "headers": { "Location": "https://ezharu.co/$1$2" }
    },
    {
      "src": "/ko(/.*)?",
      "status": 301,
      "headers": { "Location": "https://ezharu.co/ko" }
    },
    {
      "src": "/(.*)",
      "status": 301,
      "headers": { "Location": "https://ezharu.co/" }
    }
  ]
}
